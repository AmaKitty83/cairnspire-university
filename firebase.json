{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Cairnspire University",
        "supportEmail": "amarette83@gmail.com",
        "authorizedRedirectUris": [
          "https://cairnspire-university.firebaseapp.com/__/auth/handler",
          "https://cairnspire-university.web.app/__/auth/handler",
          "http://localhost:5173"
        ]
      }
    }
  }
}
